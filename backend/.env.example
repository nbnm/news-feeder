# Run the backend from backend/ so this .env file is loaded.
DATABASE_URL=sqlite:///./data/newsfeeder.db
APP_API_KEY=
ENVIRONMENT=development
DEMO_MODE=false
WORKER_ENABLED=true

# T1A LiteLLM gateway. The client appends /models and /chat/completions.
# Enter a virtual key and choose a model in Mac Settings → Models, or set them here.
LITELLM_BASE_URL=https://secondstack.t1a.io/gateway/api/v1
LITELLM_API_KEY=
LITELLM_MODEL=

# Optional Telegram delivery. Start your bot's chat first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
